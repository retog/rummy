{
    "compilerOptions": {
        "target": "es2019",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2020", "dom", "dom.iterable", "webworker.importscripts"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "../src/puzzle/**/*.ts"],
    "exclude": ["../src/puzzle/**/*.spec.ts"]
}
