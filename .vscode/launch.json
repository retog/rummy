{
    // Debug configurations for Deno (https://docs.deno.com/runtime/fundamentals/debugging/)
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Deno Tests",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "deno",
            "runtimeArgs": ["test", "--inspect-wait"],
            "attachSimplePort": 9229
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Demo",
            "program": "${workspaceFolder}/src/demo.ts",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "deno",
            "runtimeArgs": ["run", "--inspect-wait"],
            "attachSimplePort": 9229
        }
    ]
}
